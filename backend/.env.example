# Copy this file to .env (same directory) and fill in your values.
# .env is gitignored; it holds your private configuration.

# Django secret key (generate once, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
TEMPO_SECRET_KEY=change-me

# 1 in development, 0 in production
TEMPO_DEBUG=1

# Comma-separated hosts allowed to reach the API (production). Ignored while DEBUG=1.
TEMPO_ALLOWED_HOSTS=

# Single private user. The password is stored ONLY as a Django-format hash.
# Generate one with:  python manage.py hash_password
# Example format: pbkdf2_sha256$870000$<salt>$<hash>
TEMPO_USERNAME=owner
TEMPO_PASSWORD_HASH=

# Timezone used as default for the user profile (IANA name)
TEMPO_TIMEZONE=UTC

# Comma-separated origins the web/PWA client may call from (production).
# localhost origins are always allowed while TEMPO_DEBUG=1.
TEMPO_CORS_ORIGINS=

# PostgreSQL (optional; leave TEMPO_DB_ENGINE unset to use SQLite)
# TEMPO_DB_ENGINE=postgres
# TEMPO_DB_NAME=tempo
# TEMPO_DB_USER=tempo
# TEMPO_DB_PASSWORD=
# TEMPO_DB_HOST=localhost
# TEMPO_DB_PORT=5432
